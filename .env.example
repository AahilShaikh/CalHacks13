# Add your Anthropic API key below. This file stays local.
ANTHROPIC_API_KEY=

# Optional model override:
# ANTHROPIC_MODEL=claude-opus-5-5

# Turntable setup and calibration: docs/TURNTABLE.md
# AIDA_TURNTABLE_PORT=/dev/cu.usbmodemYOUR_PORT
# Select the USB webcam by name at /setup.html (saved by stable device ID).
# Optional expert overrides; a built-in-camera index is rejected:
# AIDA_TURNTABLE_CAMERA_ID=USB_DEVICE_ID_FROM_SETUP
# AIDA_TURNTABLE_CAMERA=USB_CAMERA_INDEX_FROM_SETUP
# AIDA_TURNTABLE_NEUTRAL_US=1450
# AIDA_TURNTABLE_POSITIVE_US=1550
# AIDA_TURNTABLE_NEGATIVE_US=1350
# AIDA_TURNTABLE_FINE_POSITIVE_US=1510
# AIDA_TURNTABLE_FINE_NEGATIVE_US=1390
# AIDA_TURNTABLE_POSITIVE_DPS=90
# AIDA_TURNTABLE_NEGATIVE_DPS=90
# AIDA_TURNTABLE_FINE_POSITIVE_DPS=30
# AIDA_TURNTABLE_FINE_NEGATIVE_DPS=30
# AIDA_TURNTABLE_SETTLE_S=0.25
# AIDA_TURNTABLE_STORAGE=artifacts/turntable
# COMFY_HOST=http://127.0.0.1:8188
# AIDA_ACQUISITION_STORAGE=artifacts/acquisitions
# Camera setup and automatic metric workflow: docs/AUTOMATIC_SCAN.md
